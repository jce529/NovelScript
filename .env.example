NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Service (platform) keys per provider. A provider without its key is listed but disabled in the picker
# and its service calls fail with API_KEY_MISSING; a writer's connected BYOK key still works independently.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL_VERSION=
TYPESAFE_API_BASE_URL=
JEV_TIMEOUT_MS=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Development only (ignored unless NODE_ENV=development): refusal-input | refusal-output | rate_limited | unavailable | config | slow | drop-response | off
# Use AI_PROVIDER_FIXTURE=off to explicitly disable — next dev doesn't clear removed keys from process.env, so deleting this line while the dev server is running won't turn the fixture off.
# Turning on AI_PROVIDER_FIXTURE alone does NOT allow service calls: the selected provider's real server key
# (GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY) must be set first. Without it that provider stays
# disabled and returns API_KEY_MISSING even in fixture mode; connected BYOK models remain independent.
# AI_PROVIDER_FIXTURE=

AI_DOC_PLANNING_MODE=off
AI_DOC_SHADOW_SAMPLE_RATE=0.05
AI_DOC_SHADOW_DAILY_MAX=500
