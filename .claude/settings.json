{
  "permissions": {
    "allow": [
      "Bash(node scripts/check-env.mjs*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production*)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.*.local)",
      "Bash(head *.env.local)",
      "Bash(tail *.env.local)",
      "Bash(type *.env.local)",
      "Bash(grep * .env)",
      "Bash(grep * .env.local)",
      "Bash(grep * .env.*.local)",
      "Bash(rg * .env.local)",
      "Bash(sed * .env.local)",
      "Bash(awk * .env.local)",
      "Bash(cut * .env.local)"
    ]
  }
}
